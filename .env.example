DATABASE_URL=postgresql+asyncpg://traveltom:traveltom@localhost:5432/traveltom
APP_ENV=local
TELEMETRY_SERVICE_NAME=traveltom-api
JSON_LOGS_ENABLED=true
APPLICATIONINSIGHTS_CONNECTION_STRING=
AUTH_ENABLED=false
AUTH_APP_CLIENT_ID=
AUTH_TENANT_NAME=
AUTH_POLICY_NAME=
AUTH_REQUIRED_SCOPES=user_impersonation
LOCAL_AUTH_TOKEN_SECRET=
LOCAL_AUTH_TOKEN_TTL_SECONDS=604800
LOCAL_AUTH_TOKEN_IDLE_TIMEOUT_SECONDS=43200
CHAT_RATE_LIMIT=30/minute
CHAT_RATE_LIMIT_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173
ORCHESTRATOR_LLM_PROVIDER=ollama
ORCHESTRATOR_LLM_TIMEOUT_SECONDS=20
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_PLANNING_MODEL=llama3.1:8b
OLLAMA_RESPONSE_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0
ORCHESTRATOR_OPENAI_BASE_URL=https://api.openai.com/v1
ORCHESTRATOR_OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-4.1-mini
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0
TRAVELTOM_ML_RANKER_ARTIFACT_URI=
TRAVELTOM_ML_RANKER_PROMOTED_VERSION=
TRAVELTOM_ML_RANKER_CACHE_DIR=
